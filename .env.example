# ============================================================
# BTC Predictor — Environment Variables
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env al repositorio.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=btcuser
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=btcpredictor
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# DATABASE_URL construida automáticamente por el backend.
# En Docker, POSTGRES_HOST debe ser el nombre del servicio ("postgres").
DATABASE_URL=postgresql+asyncpg://btcuser:changeme_in_production@localhost:5432/btcpredictor

# --- PgAdmin (solo desarrollo) ---
PGADMIN_EMAIL=admin@btcpredictor.local
PGADMIN_PASSWORD=pgadmin_dev_only

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true
BACKEND_AUTO_CREATE_SCHEMA=false # Docker usa migraciones Alembic; evita tablas sin versión
BACKEND_RATE_LIMIT=120/minute      # Límite global de requests por IP (slowapi)
# Frecuencia (s) con la que el backend revisa si hay una vela nueva que predecir
PREDICTION_POLL_SECONDS=300
ENVIRONMENT=development           # development | staging | production
SECRET_KEY=change_this_to_a_random_secret_key_at_least_32_chars
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR

# --- CORS ---
# Lista separada por comas de orígenes permitidos
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- ML ---
MODEL_ARTIFACT_DIR=./ml/artifacts
# Informativo: el modelo activo lo define model_registry.is_active (ver full-stack-runbook)
ACTIVE_MODEL_VERSION=2
# Imagen usada por el servicio offline ml-research; puede fijarse a una etiqueta congelada.
ML_RESEARCH_IMAGE=btc-predictor-ml-worker:latest

# --- Binance API (pública, no requiere autenticación para OHLCV) ---
BINANCE_BASE_URL=https://api.binance.com
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
FUNDING_ENABLED=true
FUNDING_RATE_LIMIT_PER_MIN=90
FUNDING_MAX_LAG_HOURS=24
FUNDING_FEATURE_MAX_AGE_HOURS=36

# --- Fuentes de volatilidad (solo rama feature/prediccion-volatilidad; requiere migración 007) ---
VOLATILITY_SOURCES_ENABLED=false
DERIBIT_BASE_URL=https://www.deribit.com
DVOL_MAX_LAG_HOURS=3
OI_MAX_LAG_HOURS=3
FOMC_REFRESH_DAYS=7
BINANCE_RATE_LIMIT_PER_MIN=1200  # Límite de la API pública
BTC_SYMBOL=BTCUSDT
DEFAULT_INTERVAL=4h               # Intervalo de velas
INGESTION_WATCHDOG_SECONDS=60     # Comprobación de rezago tras suspensión/reconexión

# --- yfinance ---
MACRO_SYMBOLS=DX-Y.NYB,^GSPC,^VIX,GC=F

# --- Fear & Greed Index ---
FEAR_GREED_BASE_URL=https://api.alternative.me/fng/

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
